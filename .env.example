# Optional merchant lookup. Keep the Parallel API key server-side.
PARALLEL_API_KEY=

# Local mode defaults. For a hosted instance, set these explicitly:
# LEDGER_AUTH_REQUIRED=1
# LEDGER_SECURE_COOKIES=1
# LEDGER_TRUST_PROXY=1
# LEDGER_BOOTSTRAP_ADMIN_EMAIL=you@example.com
# LEDGER_BOOTSTRAP_ADMIN_NAME=Your Name
# LEDGER_BOOTSTRAP_ADMIN_PASSWORD=choose-a-unique-16-character-or-longer-secret
# Hosted passkeys must use the exact public HTTPS origin and its hostname as the RP ID.
# WEBAUTHN_ORIGIN=https://ledger.example.com
# WEBAUTHN_RP_ID=ledger.example.com
# Generate an encryption key with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LEDGER_BACKUP_FERNET_KEY=
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> to the backup route.
CRON_SECRET=
